DATABASE_URL=sqlite:///./vittvaani.db
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AI_API_KEY=
AI_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
# Text intelligence model. Use a REST-capable model such as gemini-3.6-flash.
# Live/native-audio "speaker" models (e.g. gemini-2.5-flash-preview-native-audio-dialog,
# gemini-3.1-flash-live-preview) run ONLY over the Live API (WebSocket) and are used
# by the voice-agent module; they are never called for text JSON extraction.
GEMINI_MODEL=gemini-3.6-flash
FRONTEND_URL=http://localhost:8080
ENVIRONMENT=development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
